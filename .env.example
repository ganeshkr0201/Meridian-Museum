# ============================================================
# Museum Exhibit Guide — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=museum_guide

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Embedding Model ---
# Sentence-transformers model name (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM Provider ---
# Set to "demo" for deterministic demo mode without an API key.
# Set to "openai" to use the OpenAI-compatible provider.
LLM_MODE=demo

# OpenAI-compatible API (only required when LLM_MODE=openai)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Security ---
SECRET_KEY=change-me-in-production
